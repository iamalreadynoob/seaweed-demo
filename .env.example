# SeaweedFS S3 gateway (see the `s3` service in docker-compose.yaml).
# Copy this file to `.env` and adjust the values as needed.
SEAWEED_S3_ENDPOINT=http://localhost:8333

# Must match an identity in s3.json. Use readonly_access_key /
# readonly_secret_key for an identity limited to Read and List.
SEAWEED_S3_ACCESS_KEY=admin_access_key
SEAWEED_S3_SECRET_KEY=admin_secret_key
SEAWEED_S3_REGION=us-east-1
